  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/gme/workflow" },
